# Copie para .env (que está no .gitignore) e preencha localmente.
# Carregue no terminal/IDE; o código lê apenas variáveis de ambiente.
FIREBASE_PROJECT_ID=SEU_PROJETO_FIREBASE

# Opção 1 (recomendada local): caminho do JSON da conta de serviço, FORA do repositório
GOOGLE_APPLICATION_CREDENTIALS=/caminho/seguro/fora/do/repo/service-account.json

# Opção 2 (CI/hospedagem): conteúdo do JSON inteiro em uma variável (tem prioridade)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Trava de segurança do script de seed
SEED_ENV=development
